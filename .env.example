# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collab-editor

# ============================================
# BETTER AUTH
# ============================================
BETTER_AUTH_SECRET=your-secret-key-here

# ============================================
# EMAIL SERVICE (Resend)
# ============================================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ============================================
# OAUTH PROVIDERS (optional — only registered if both id+secret are set)
# ============================================

# Google OAuth: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# APPLICATION URL
# ============================================
# Frontend and API are the same Next.js app now (same origin) — there is no separate
# NEXT_PUBLIC_API_URL anymore.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# OBJECT STORAGE (S3-compatible)
# ============================================
# lib/object-storage.ts is provider-agnostic — it just points the AWS S3 SDK at whatever these
# say, so switching provider is a config change, not a code change.
#
# Local dev: MinIO via `docker-compose up minio` (values below match its container defaults).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=artifact-uploads
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/artifact-uploads

# Production: Tigris (https://www.tigrisdata.com) — a global S3-compatible bucket, no server to
# run. The `artifact-uploads` bucket and access key already exist (created via the `tigris` CLI —
# see ~/.tigris/config.json). It's currently PRIVATE: Tigris requires a verified payment method on
# the account before a bucket can be made public (`tigris buckets set artifact-uploads --access
# public` fails with "A verified payment method is required to make bucket public" until then) —
# add one at https://console.tigrisdata.com, then re-run that command. Until it's public,
# uploadObject()'s bare public URLs (same approach as MinIO's `mc anonymous set download`) will
# 403 — nothing else needs to change once the bucket itself is flipped to public. Leave unset
# locally.
# S3_ENDPOINT=https://t3.storage.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=tid_...
# S3_SECRET_ACCESS_KEY=tsec_...
# S3_BUCKET=artifact-uploads
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_URL=https://artifact-uploads.t3.tigrisfiles.io

# ============================================
# REDIS (rate-limit store, read cache)
# ============================================
# Two backends, picked by NODE_ENV (see lib/redis.ts) — never by which of these happen to be set,
# so it's safe to keep both in one local .env:
#
# Local dev (NODE_ENV != production): plain TCP Redis via `docker-compose up redis` + REDIS_URL.
REDIS_URL=redis://localhost:6379

# Production only (NODE_ENV=production): Upstash's REST API — required there, since a serverless
# deployment can't hold the persistent TCP connection pool a local docker container can. Get these
# from https://console.upstash.com/redis/<uuid> (the "REST API" panel, not the TCP connection
# string). Leave unset locally.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ============================================
# BACKGROUND JOBS (Inngest — see lib/inngest/)
# ============================================
# Local dev: run `npm run inngest:dev` (or `npm run dev:all` to run it alongside `next dev`) —
# the local Inngest Dev Server auto-discovers this app's functions via app/api/inngest/route.ts,
# no keys needed.
#
# Production only (Inngest Cloud — leave unset locally):
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ============================================
# LOGGING & ENVIRONMENT
# ============================================
LOG_LEVEL=debug
NODE_ENV=development
