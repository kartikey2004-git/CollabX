// Groundwork : engineering knowledge platform (articles, curated tech reads)

// Platform wide Role-Based Access Control. Admin has full CRUD, moderation, and publishing rights. Contributor can create and submit content for review, but cannot update or publish it directly. Reader is the default role for users who can browse and comment but do not have contributor access. 

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  // Prisma 7's `prisma-client` generator is ESM-first by default; this app's package.json has no
  // "type": "module", so without forcing cjs output here, `next build`'s Node runtime bundling and
  // any plain `node`-run script (worker/index.ts, scripts/seed.ts) can hit
  // "ReferenceError: exports is not defined in ES module scope" the moment they touch this client.
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Use a DB-level enum instead of a string to enforce valid roles.

enum Role {
  ADMIN
  CONTRIBUTOR
  READER
}

// Fixed top-level sections used to organize articles. 

enum Category {
  BACKEND_ENGINEERING
  FRONTEND_ENGINEERING
  ENGINEER_ARTICLES
  SYSTEM_DESIGN
  DISTRIBUTED_SYSTEMS
  INFRASTRUCTURE
  DEVOPS
}

// Draft -> pending review -> published/rejected. Shared by Article and TechRead submissions so both content
// types moderate through the same state machine. There is no separate APPROVED state: review approval and
// publication happen as a single admin action (see Submission below) - if a future workflow needs a
// hold-for-later-publish step, reintroduce APPROVED then. The enum only enforces which values are legal;
// which transitions are legal (e.g. PUBLISHED -> DRAFT is not) is validated in the application layer.

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

// Distinguishes what a Verification row is for, replacing the free-text `type` string.

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// A human being using the app which is core identity, authentication, and profile management

model User {
  id String @id @default(cuid()) // primary keys  are collision-resistant, URL-safe, and shorter than UUIDv4 used for API routing, external identifiers.

  // name and email is normalized identity for display, login, notifications.

  name  String
  email String @unique // prevents duplicate accounts with the same email.

  // id is immutable and email must remain unique.

  emailVerified Boolean @default(false) // Prevents spam/abuse by ensuring email ownership which is gating features (e.g., submitting content).

  image String? // URL to avatar used for User Interface profile display

  passwordHash String? @db.Text // Bcrypt/Argon2 hash: Text allows long hashes used for credential login (null if OAuth only).

  // Platform-level role and moderation controls.

  role       Role      @default(READER)
  banned     Boolean   @default(false)
  banReason  String?   @db.Text
  banExpires DateTime? @db.Timestamptz(3)

  // For Audit trail where Timestamptz handles timezones and (3) gives ms precision.

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts Account[]
  sessions Session[]

  // App Relations

  createdArticles  Article[]  @relation("ArticleCreator")
  createdTechReads TechRead[] @relation("TechReadCreator")

  authoredSubmissions Submission[] @relation("SubmissionAuthor")
  reviewedSubmissions Submission[] @relation("SubmissionReviewer")

  comments       Comment[]
  uploadedAssets Asset[]

  @@index([createdAt]) // Sorting users by "Newest" and also B-Tree makes this O(log N) but its tradeoff is slight write overhead.
  @@map("users")
}

// Auth mechanisms which handles credentials, OAuth (GitHub/Google), magic links, and session tracking securely.

model Session {
  id String @id @default(cuid())

  token String @unique // Secure and random session identifier which is in cookie/Header usef for auth validation and also ensures session tokens are globally unique for fast, secure lookups.

  // token is the actual secret used for auth and id is for internal DB relations.

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Security context used for detecting suspicious logins, device management.

  ipAddress String?
  userAgent String?

  expiresAt DateTime @db.Timestamptz(3) // Forces re-authentication enables auto-logout, security compliance.

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId]) // "Get all sessions for User X" which is crucial for login/device management but tradeoff is having a storage cost.
  @@index([expiresAt]) // helping in cleanup jobs, Cron jobs run DELETE WHERE expiresAt < now() for orphaned and past stale/unused sessions. Index makes this lightning fast.
  @@map("sessions")
}

model Account {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OAuth provider (e.g., 'github') ID and their user ID which helps in linking external identities.

  accountId  String
  providerId String

  // OAuth tokens which used for calling external APIs on behalf of the user

  accessToken  String? @db.Text
  refreshToken String? @db.Text

  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)

  scope    String?
  idToken  String? @db.Text
  password String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId]) // Prevents linking the same OAuth account to multiple internal users.
  @@index([userId]) // "Get all accounts for User X". Crucial for login/device management but tradeoff is having a storage cost.
  @@map("accounts")
}

model Verification {
  id String @id @default(cuid())

  // identifier is the email/user (or, for OAuth sign-in, a random per-attempt state id) the row was issued
  // for. better-auth reuses this same table for email-verification/password-reset tokens AND OAuth PKCE
  // state (codeVerifier, oauthState, callbackURL as JSON) - the latter must be read back verbatim during
  // the OAuth callback, so `value` cannot be a one-way hash here; better-auth's adapter always reads/writes
  // this column under the literal field name `value`, unmapped, so it must keep that name.

  identifier String
  value      String           @db.Text
  type       VerificationType @default(EMAIL_VERIFICATION)

  expiresAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([identifier, type])
  @@index([identifier])
  @@index([type])
  @@index([expiresAt])
  @@map("verifications")
}

// A long-form Markdown knowledge base entry (Backend/Frontend Engineering, Engineer Articles, System Design,
// Distributed Systems, Infrastructure, DevOps). The Article row is the stable envelope: title/summary/status
// are denormalized from currentSubmission for fast listing and category browsing, while the actual Markdown
// body lives on Submission so every edit is a new, independently reviewable version.

model Article {
  id String @id @default(cuid())

  slug     String   @unique // URL-friendly ID for SEO and clean URLs.
  category Category

  // Denormalized from the current submission for fast listing/search without a join, mirrored from
  // contentSize-style denormalization in the original schema. Kept in sync whenever a submission is published.

  title   String
  summary String? @db.Text

  status ContentStatus @default(DRAFT) // Mirrors currentSubmission.status; lets "show all PUBLISHED articles in category X" run without a join.

  currentSubmissionId String?     @unique
  currentSubmission   Submission? @relation("ArticleCurrentSubmission", fields: [currentSubmissionId], references: [id], onDelete: SetNull)

  submissions Submission[] @relation("ArticleSubmissions")

  // createdBy is the original contributor. Contributors can create/submit new Submissions against their own
  // article but cannot update this row or flip status themselves - only ADMIN moderation actions do that.

  createdBy String
  creator   User   @relation("ArticleCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  publishedAt DateTime? @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3) // Soft delete keeps data for recovery/audit.

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  comments Comment[]

  // Assets hang off Submission (see below), since an uploaded image belongs to one specific
  // reviewed version of the content, not to the Article as a whole.

  @@index([category, status])
  @@index([createdBy])
  @@index([status])
  @@index([publishedAt])
  @@index([updatedAt])
  @@index([createdAt])
  @@index([category, deletedAt]) // Partial Index Candidate for fetching active articles WHERE category = X AND deletedAt IS NULL.
  @@map("articles")
}

// A curated/trending external technical resource (blog post, talk, paper) - the "Trending Tech Reads" section.
// Shares the same Submission-based moderation workflow as Article so curators (contributors) can propose reads
// and admins approve/publish them, without needing a second parallel review pipeline.

model TechRead {
  id String @id @default(cuid())

  slug String @unique

  // Denormalized from the current submission, same rationale as Article.

  title       String
  description String? @db.Text // Curator's annotation/summary of the linked resource - not an original write-up.

  externalUrl String // Required: TechRead only curates external resources (blog posts, talks, papers), never original write-ups.
  sourceName  String? // e.g. "InfoQ", "Martin Fowler's Blog" - display attribution for the source.

  category Category? // Optional - trending reads can span or ignore the fixed categories.
  tags     String[] // Free-form topical tags for finer-grained curation than Category alone allows.

  isTrending    Boolean @default(false) // Toggled by admins/curation job to feature this read.
  trendingScore Int     @default(0) // Ranking weight for the trending feed.

  status ContentStatus @default(DRAFT)

  currentSubmissionId String?     @unique
  currentSubmission   Submission? @relation("TechReadCurrentSubmission", fields: [currentSubmissionId], references: [id], onDelete: SetNull)

  submissions Submission[] @relation("TechReadSubmissions")

  createdBy String
  creator   User   @relation("TechReadCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  publishedAt DateTime? @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  comments Comment[]

  @@index([isTrending, trendingScore])
  @@index([category, status])
  @@index([createdBy])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("tech_reads")
}

// A single reviewable version of an Article or TechRead's Markdown content (Mermaid diagrams render straight
// out of ```mermaid fences in `content`, so no dedicated diagram field is needed). Exactly one of articleId /
// techReadId must be set per row - Prisma's schema language has no CHECK-constraint attribute, so this is
// enforced with a raw-SQL migration (see migrations/<timestamp>_content_submission_ownership/migration.sql):
//
//   ALTER TABLE "submissions" ADD CONSTRAINT "submissions_article_xor_tech_read"
//     CHECK (num_nonnulls("articleId", "techReadId") = 1);
//
// (Postgres treats the unused nullable FK as NULL, which is also why the per-parent unique([x, version])
// constraints below don't collide across rows - NULL <> NULL for uniqueness purposes.)
//
// This is the versioning/submission mechanism that makes rejection non-editable in place: a contributor's
// rejected submission is never mutated - the app instead creates a brand new Submission (next version number)
// against the same Article/TechRead for another review pass.
//
// Status transitions (DRAFT -> PENDING_REVIEW -> PUBLISHED/REJECTED) are validated in the application layer,
// not the DB - the ContentStatus enum only guarantees the column holds one of those four legal values. When an
// admin publishes a submission, the application MUST update, inside a single prisma.$transaction: this row's
// status -> PUBLISHED (+ reviewedBy/reviewedAt), and on the parent Article/TechRead: status -> PUBLISHED,
// currentSubmissionId -> this row's id, and publishedAt -> now(). Doing this outside a transaction is how you
// end up with a "published" article whose currentSubmissionId still points at the old version.

model Submission {
  id String @id @default(cuid())

  version Int

  articleId String?
  article   Article? @relation("ArticleSubmissions", fields: [articleId], references: [id], onDelete: Cascade)

  techReadId String?
  techRead   TechRead? @relation("TechReadSubmissions", fields: [techReadId], references: [id], onDelete: Cascade)

  articleCurrentFor  Article?  @relation("ArticleCurrentSubmission")
  techReadCurrentFor TechRead? @relation("TechReadCurrentSubmission")

  title   String
  summary String? @db.Text
  content String  @db.Text // Markdown source, including any ```mermaid fences.

  status ContentStatus @default(DRAFT)

  // Contributor who authored/submitted this version. Restrict prevents deleting a user while their
  // submission history still exists, preserving audit integrity (matches the original schema's Version/Artifact pattern).

  submittedBy String
  submitter   User      @relation("SubmissionAuthor", fields: [submittedBy], references: [id], onDelete: Restrict)
  submittedAt DateTime? @db.Timestamptz(3)

  // Admin who moderated this version. SetNull on delete: the review decision and content stand even if the
  // reviewing admin's account is later removed.

  reviewedBy      String?
  reviewer        User?     @relation("SubmissionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt      DateTime? @db.Timestamptz(3)
  rejectionReason String?   @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Assets are derived from this specific version's Markdown content, not from the
  // Article/TechRead as a whole - an older, unpublished, or rejected version can have its own images
  // without colliding with the currently-published version's.

  assets Asset[]

  @@unique([articleId, version]) // Monotonic version numbers per article ("v1, v2, v3" UI); NULL articleId rows (TechRead submissions) never collide here.
  @@unique([techReadId, version])
  @@index([articleId, status])
  @@index([techReadId, status])
  @@index([status, submittedAt]) // Admin moderation queue: "all PENDING_REVIEW submissions, newest first".
  @@index([submittedBy])
  @@index([reviewedBy])
  @@map("submissions")
}

// Reusable comment/reply system shared by Articles and Tech Reads. Exactly one of articleId / techReadId must
// be set per row - same DB-level CHECK-constraint pattern as Submission (no Prisma attribute for this, so it's
// added via raw SQL migration):
//
//   ALTER TABLE "comments" ADD CONSTRAINT "comments_article_xor_tech_read"
//     CHECK (num_nonnulls("articleId", "techReadId") = 1);
//
// so replies and moderation logic is written once instead of duplicated per content type.

model Comment {
  id String @id @default(cuid())

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  techReadId String?
  techRead   TechRead? @relation(fields: [techReadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentCommentId String? // Self foreign-key for threaded replies.

  // Restrict (not Cascade): physically deleting a parent comment that still has replies is refused by the DB,
  // so the only way to remove a parent with a live thread is the existing soft-delete (deletedAt) path - the
  // row (and its body) can be blanked/flagged, but replies are never orphaned or destroyed as a side effect.
  parentComment Comment?  @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Restrict)
  replies       Comment[] @relation("CommentThread")

  body String @db.Text

  deletedAt DateTime? @db.Timestamptz(3) // Soft delete for author removal or admin moderation.

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([articleId, createdAt(sort: Desc)])
  @@index([techReadId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([parentCommentId])
  @@map("comments")
}

// An uploaded image (or other Markdown-embeddable file) referenced by URL from a Submission's Markdown
// content. Owned by the specific Submission it was uploaded for (not the Article/TechRead directly) - each
// reviewable version has its own set of images, so an asset only used in a rejected draft doesn't get mixed up
// with the currently-published version's assets. Because there's a single required FK here, there's no
// exactly-one-of-two-columns ambiguity and no CHECK constraint is needed (contrast Submission/Comment above).

model Asset {
  id String @id @default(cuid())

  url        String // Public URL used inside Markdown (e.g. ![alt](url)).
  storageKey String? // Underlying object storage key (e.g. S3), for deletion/cleanup.
  mimeType   String?
  size       Int? // Bytes.
  width      Int?
  height     Int?

  uploadedBy String
  uploader   User   @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([uploadedBy])
  @@index([submissionId])
  @@map("assets")
}

/**
 * - All createdAt and updatedAt @default(now()) : ensures accurate audit trails even if the application server's clock is slightly off (DB handles it).
 * - Required Fields and most primary keys , foreign keys : Enforces referential integrity. You can't have a Submission without an Article or TechRead.
 */

/**
 * Role model (Admin / Contributor / Reader)
 * - Global Role enum on User replaces the old per-workspace WorkspaceRole - this product has no
 * multi-tenant workspaces, so roles are platform-wide: ADMIN moderates and publishes everything,
 * CONTRIBUTOR may create Articles/TechReads and Submissions but never update or publish them directly,
 * READER is the default for everyone else (can still comment).
 * Draft -> Pending Review -> Published/Rejected
 * - ContentStatus lives on Submission (the source of truth for a specific version) and is denormalized
 * onto Article/TechRead (status) for the currently-live version, mirroring the contentSize-style
 * denormalization already used in the original schema. There is no separate APPROVED state: an admin
 * reviewing a PENDING_REVIEW submission either PUBLISHEs or REJECTs it in one action.
 * - Rejection is not editable in place: a REJECTED Submission is left untouched, and the contributor's
 * next edit becomes a new Submission row (next version) against the same Article/TechRead. This is
 * the versioning/submission mechanism the product requires.
 * - The ContentStatus enum enforces only which *values* are legal. Which *transitions* are legal (e.g. a
 * contributor can't set PUBLISHED, PUBLISHED can't go back to DRAFT) is validated in the application
 * layer, and publish/reject actions must update Submission.status + the parent's
 * status/currentSubmissionId/publishedAt together inside one prisma.$transaction (see the comment on
 * Submission above) so those four fields never observably disagree.
 * Exactly-one-of-two-columns associations (Comment, Submission)
 * - Comment and Submission each have nullable articleId/techReadId pairs instead of either two full
 * parallel tables (one per content type) or an untyped/no-FK polymorphic column. A raw-SQL CHECK
 * constraint on each table (see the comments above Submission and Comment) enforces that exactly one of
 * the pair is set - Prisma's schema language has no attribute for this, so it's added by hand-written
 * migration SQL rather than expressed declaratively here. This keeps referential integrity and cascading
 * deletes while letting replies/moderation and versioning be written once and reused across both
 * Articles and Tech Reads.
 * - Asset is NOT part of this pattern: it belongs to one specific Submission (a
 * single required FK), so there's nothing to CHECK - the version it's attached to already resolves to
 * exactly one Article or TechRead.
 * Cascading Behaviors (Crucial for Data Integrity)
 * - onDelete: Cascade: Used for Session, Account, Submission, Comment, Asset.
 * - Why? If an Article/TechRead is deleted, its submissions are meaningless without it and should
 * vanish, and each submission's own assets go with it. Comments cascade with their
 * Article/TechRead for the same reason.
 * - onDelete: Restrict: Used for Article.createdBy, TechRead.createdBy, Submission.submittedBy,
 * Asset.uploadedBy, and Comment.parentComment (self-relation).
 * - Why (authors)? Audit Integrity. If a Contributor creates an article or submission, deleting that
 * user is not allowed while the content still exists. The application must reassign ownership or
 * remove the content first.
 * - Why (parentComment)? A parent comment with live replies can't be physically deleted at all - the DB
 * refuses it, forcing the application to use the existing deletedAt soft-delete instead, so replies
 * always survive their parent being "removed."
 * - onDelete: SetNull: Used for Submission.reviewedBy, Article.currentSubmission, TechRead.currentSubmission.
 * - Why? The reviewing admin's identity or the pointer to the live version is metadata, not ownership -
 * losing it should not block deleting a user or a submission row.
 */
